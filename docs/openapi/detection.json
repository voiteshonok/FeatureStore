{
  "openapi": "3.1.0",
  "info": {
    "title": "Feature Store Detection",
    "description": "Internal alert and rule API. Operators reach it through the gateway, which sets X-Operator-Id and X-Operator-Role.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8002"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Health",
        "description": "The process is up. This probe does not check Kafka or Postgres.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Process is running.",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                },
                "example": {
                  "status": "ok"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "description": "Correlation id. Echoed from the request or generated when the header is empty.",
                "schema": {
                  "type": "string"
                },
                "example": "6f1c2a40-9b17-4e5a-8c31-0a6d4e8b7f22"
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "security": [],
        "parameters": [
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Correlation id. Generated when the header is empty."
          }
        ]
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Ready",
        "description": "The consumer is running and Postgres answers within one second.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "description": "Kafka consumer and Postgres are up.",
            "content": {
              "application/json": {
                "schema": {},
                "example": {
                  "status": "ready",
                  "kafka": "ok",
                  "postgres": "ok"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "description": "Correlation id. Echoed from the request or generated when the header is empty.",
                "schema": {
                  "type": "string"
                },
                "example": "6f1c2a40-9b17-4e5a-8c31-0a6d4e8b7f22"
              }
            }
          },
          "503": {
            "description": "A dependency is down.",
            "content": {
              "application/json": {
                "example": {
                  "status": "not_ready",
                  "kafka": "down",
                  "postgres": "ok"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "description": "Correlation id. Echoed from the request or generated when the header is empty.",
                "schema": {
                  "type": "string"
                },
                "example": "6f1c2a40-9b17-4e5a-8c31-0a6d4e8b7f22"
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "security": [],
        "parameters": [
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Correlation id. Generated when the header is empty."
          }
        ]
      }
    },
    "/v1/alerts": {
      "get": {
        "tags": [
          "alerts"
        ],
        "summary": "List alerts",
        "description": "Keyset page of alerts. The gateway only proxies a session caller.",
        "operationId": "list_alerts_v1_alerts_get",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "enum": [
                      "open",
                      "acknowledged",
                      "resolved"
                    ],
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "name": "entity",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Entity"
            }
          },
          {
            "name": "entity_type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "card",
                    "merchant"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Entity Type"
            }
          },
          {
            "name": "rule_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Rule Id"
            }
          },
          {
            "name": "created_from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Created From"
            }
          },
          {
            "name": "created_to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Created To"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "created_at",
                "-created_at"
              ],
              "type": "string",
              "default": "-created_at",
              "title": "Sort"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 1,
              "default": 100,
              "title": "Limit"
            }
          },
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Correlation id. Generated when the header is empty."
          }
        ],
        "responses": {
          "200": {
            "description": "One page of alerts.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertListOut"
                },
                "example": {
                  "items": [
                    {
                      "alert_id": "6a4e2f0c-1d8b-4a37-9b9e-2c7f5e1a0b44",
                      "rule_id": "c0ffee00-0000-4000-8000-000000000001",
                      "status": "open",
                      "merchant_id": null,
                      "card_token": "c0ffee00c0ffee00c0ffee00c0ffee00c0ffee00c0ffee00c0ffee00c0ffee00",
                      "event_id": "3b7f0d0e-5c9a-4c27-a1b1-f0f3d2a9e811",
                      "feature_snapshot": {
                        "card_cnt_1m": 6
                      },
                      "created_at": "2026-11-24T18:01:12.418Z",
                      "resolved_at": null,
                      "acknowledged_at": null,
                      "acknowledged_by": null,
                      "resolved_by": null,
                      "resolution_note": null
                    }
                  ],
                  "next_cursor": null
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "description": "Correlation id. Echoed from the request or generated when the header is empty.",
                "schema": {
                  "type": "string"
                },
                "example": "6f1c2a40-9b17-4e5a-8c31-0a6d4e8b7f22"
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "security": []
      }
    },
    "/v1/alerts/{alert_id}": {
      "get": {
        "tags": [
          "alerts"
        ],
        "summary": "Get alert",
        "description": "One alert with its rule and audit history.",
        "operationId": "get_alert_v1_alerts__alert_id__get",
        "parameters": [
          {
            "name": "alert_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Alert Id"
            }
          },
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Correlation id. Generated when the header is empty."
          }
        ],
        "responses": {
          "200": {
            "description": "Alert, rule, and audit history.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertDetailOut"
                },
                "example": {
                  "alert": {
                    "alert_id": "6a4e2f0c-1d8b-4a37-9b9e-2c7f5e1a0b44",
                    "rule_id": "c0ffee00-0000-4000-8000-000000000001",
                    "status": "open",
                    "merchant_id": null,
                    "card_token": "c0ffee00c0ffee00c0ffee00c0ffee00c0ffee00c0ffee00c0ffee00c0ffee00",
                    "event_id": "3b7f0d0e-5c9a-4c27-a1b1-f0f3d2a9e811",
                    "feature_snapshot": {
                      "card_cnt_1m": 6
                    },
                    "created_at": "2026-11-24T18:01:12.418Z",
                    "resolved_at": null,
                    "acknowledged_at": null,
                    "acknowledged_by": null,
                    "resolved_by": null,
                    "resolution_note": null
                  },
                  "rule": {
                    "rule_id": "c0ffee00-0000-4000-8000-000000000001",
                    "name": "card_velocity_burst",
                    "entity": "card",
                    "enabled": true,
                    "conditions": [
                      {
                        "feature_name": "card_cnt_1m",
                        "comparison": "gt",
                        "threshold": 5
                      }
                    ]
                  },
                  "history": [
                    {
                      "audit_id": 1,
                      "occurred_at": "2026-11-24T18:01:12.418Z",
                      "actor": "analyst@featurestore.local",
                      "action": "created",
                      "detail": {}
                    }
                  ]
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "description": "Correlation id. Echoed from the request or generated when the header is empty.",
                "schema": {
                  "type": "string"
                },
                "example": "6f1c2a40-9b17-4e5a-8c31-0a6d4e8b7f22"
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "security": []
      },
      "patch": {
        "tags": [
          "alerts"
        ],
        "summary": "Update alert status",
        "description": "Change an alert status. The gateway allows this only for roles analyst and admin and requires X-Requested-With: fetch. Allowed transitions: open to acknowledged, acknowledged to resolved, and open to resolved. resolved is final. A note of 3\u2013500 characters is required when resolving.",
        "operationId": "patch_alert_v1_alerts__alert_id__patch",
        "parameters": [
          {
            "name": "alert_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Alert Id"
            }
          },
          {
            "name": "X-Operator-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "X-Operator-Id"
            }
          },
          {
            "name": "X-Operator-Role",
            "in": "header",
            "required": true,
            "schema": {
              "enum": [
                "viewer",
                "analyst",
                "admin"
              ],
              "type": "string",
              "title": "X-Operator-Role"
            }
          },
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Correlation id. Generated when the header is empty."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AlertUpdate"
              },
              "examples": {
                "typical": {
                  "summary": "Acknowledge an open alert",
                  "value": {
                    "status": "acknowledged"
                  }
                },
                "edge": {
                  "summary": "Resolve with a note",
                  "value": {
                    "status": "resolved",
                    "note": "Confirmed with cardholder, legitimate travel"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Alert after the transition.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertOut"
                },
                "example": {
                  "alert_id": "6a4e2f0c-1d8b-4a37-9b9e-2c7f5e1a0b44",
                  "rule_id": "c0ffee00-0000-4000-8000-000000000001",
                  "status": "acknowledged",
                  "merchant_id": null,
                  "card_token": "c0ffee00c0ffee00c0ffee00c0ffee00c0ffee00c0ffee00c0ffee00c0ffee00",
                  "event_id": "3b7f0d0e-5c9a-4c27-a1b1-f0f3d2a9e811",
                  "feature_snapshot": {
                    "card_cnt_1m": 6
                  },
                  "created_at": "2026-11-24T18:01:12.418Z",
                  "resolved_at": null,
                  "acknowledged_at": "2026-11-24T18:05:00.000Z",
                  "acknowledged_by": "analyst@featurestore.local",
                  "resolved_by": null,
                  "resolution_note": null
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "description": "Correlation id. Echoed from the request or generated when the header is empty.",
                "schema": {
                  "type": "string"
                },
                "example": "6f1c2a40-9b17-4e5a-8c31-0a6d4e8b7f22"
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "security": []
      }
    },
    "/v1/rules": {
      "get": {
        "tags": [
          "rules"
        ],
        "summary": "List rules",
        "description": "Rules with their comparison conditions.",
        "operationId": "list_rules_v1_rules_get",
        "responses": {
          "200": {
            "description": "Seeded rules.",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RuleOut"
                  },
                  "type": "array",
                  "title": "Response List Rules V1 Rules Get"
                },
                "example": [
                  {
                    "rule_id": "c0ffee00-0000-4000-8000-000000000001",
                    "name": "card_velocity_burst",
                    "entity": "card",
                    "enabled": true,
                    "conditions": [
                      {
                        "feature_name": "card_cnt_1m",
                        "comparison": "gt",
                        "threshold": 5
                      }
                    ]
                  },
                  {
                    "rule_id": "c0ffee00-0000-4000-8000-000000000003",
                    "name": "merchant_decline_wave",
                    "entity": "merchant",
                    "enabled": true,
                    "conditions": [
                      {
                        "feature_name": "merchant_decline_rate_24h",
                        "comparison": "gt",
                        "threshold": 0.35
                      },
                      {
                        "feature_name": "merchant_cnt_24h",
                        "comparison": "ge",
                        "threshold": 20
                      }
                    ]
                  }
                ]
              }
            },
            "headers": {
              "X-Request-ID": {
                "description": "Correlation id. Echoed from the request or generated when the header is empty.",
                "schema": {
                  "type": "string"
                },
                "example": "6f1c2a40-9b17-4e5a-8c31-0a6d4e8b7f22"
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "security": [],
        "parameters": [
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Correlation id. Generated when the header is empty."
          }
        ]
      }
    },
    "/v1/stream/alerts": {
      "get": {
        "tags": [
          "stream"
        ],
        "summary": "Alert stream",
        "description": "Server-Sent Events of alert and stats frames. Payloads: docs/asyncapi/alerts-stream.yaml.",
        "operationId": "stream_alerts_v1_stream_alerts_get",
        "parameters": [
          {
            "name": "Last-Event-ID",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Last-Event-Id"
            }
          },
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Correlation id. Generated when the header is empty."
          }
        ],
        "responses": {
          "200": {
            "description": "SSE stream. See docs/asyncapi/alerts-stream.yaml.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "example": "event: alert\nid: 42\ndata: {\"id\":42,\"op\":\"created\",\"alert_id\":\"6a4e2f0c-1d8b-4a37-9b9e-2c7f5e1a0b44\",\"rule_id\":\"c0ffee00-0000-4000-8000-000000000001\",\"rule_name\":\"card_velocity_burst\",\"status\":\"open\",\"entity\":\"card\",\"entity_id\":\"c0ff\u2026e00\",\"created_at\":\"2026-11-24T18:01:12.418Z\"}\n\n"
              }
            },
            "headers": {
              "X-Request-ID": {
                "description": "Correlation id. Echoed from the request or generated when the header is empty.",
                "schema": {
                  "type": "string"
                },
                "example": "6f1c2a40-9b17-4e5a-8c31-0a6d4e8b7f22"
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "503": {
            "$ref": "#/components/responses/UpstreamUnavailable"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "AlertDetailOut": {
        "properties": {
          "alert": {
            "$ref": "#/components/schemas/AlertOut"
          },
          "rule": {
            "$ref": "#/components/schemas/RuleOut"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/AuditEntryOut"
            },
            "type": "array",
            "title": "History"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "alert",
          "rule",
          "history"
        ],
        "title": "AlertDetailOut",
        "description": "Alert card: row, rule, and audit history."
      },
      "AlertListOut": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AlertOut"
            },
            "type": "array",
            "title": "Items"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "additionalProperties": false,
        "type": "object",
